{
  "name": "yes-chef",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "run_worker_first": ["/agents/*", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "YesChefAgent", "class_name": "YesChefAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YesChefAgent"] }],
  "vars": { "MONGODB_DB": "yeschef", "DEMO_SLOW": "0" },
  "observability": { "enabled": true }
}
